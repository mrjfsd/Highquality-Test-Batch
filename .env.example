# ==============================================================================
# Style-Edit — Environment Configuration
# ==============================================================================
# Copy this file to .env.local and fill in values from your Supabase & Cloudflare dashboards:
#   copy .env.example .env.local
# DO NOT commit .env.local or any real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database & Authentication)
# ------------------------------------------------------------------------------

# Public Supabase URL (Used by browser and server)
# Source: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase Anon / Publishable Key (Browser-safe, subject to RLS)
# Source: Supabase Dashboard -> Project Settings -> API -> Project API keys -> "anon" / "public"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key-here
# NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted as fallback
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
# Used by backend Route Handlers to perform admin operations and bypass RLS safely
# Source: Supabase Dashboard -> Project Settings -> API -> Project API keys -> "service_role" (Secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Cloudflare R2 (Private Object Storage)
# ------------------------------------------------------------------------------
# Images are stored in a private R2 bucket and delivered via short-lived signed URLs.
# ALL R2 credentials are strictly SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.

# Cloudflare Account ID (32-character hex string)
# Source: Cloudflare Dashboard -> R2 Overview (top-right side of page)
R2_ACCOUNT_ID=your-cloudflare-account-id-here

# Cloudflare R2 API Token — Access Key ID
# Source: Cloudflare Dashboard -> R2 -> "Manage R2 API Tokens" -> Create Token
# Permissions: Object Read & Write, scoped to your bucket
R2_ACCESS_KEY_ID=your-r2-access-key-id-here

# Cloudflare R2 API Token — Secret Access Key
# Source: Displayed once upon R2 API token creation
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key-here

# Private Cloudflare R2 Bucket Name
# Keep public access DISABLED on this bucket.
R2_BUCKET_NAME=style-edit-products
